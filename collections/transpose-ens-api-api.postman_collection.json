          "name": "Get ENS Transfers",
          "request": {
            "name": "Get ENS Transfers",
            "description": {
              "content": "Retrieve all historical and live ENS name transfers and registrations. Filter by ENS name or token ID.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ens",
                "transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ens_name",
                  "value": "<string>",
                  "description": "Filter transfers by ENS name."
                },
                {
                  "disabled": false,
                  "key": "token_id",
                  "value": "<string>",
                  "description": "Filter transfers by ENS token ID."
                },
                {
                  "disabled": false,
                  "key": "transferred_after",
                  "value": "<string>",
                  "description": "The earlier transfer date, inclusive. Accepts Unix epoch seconds or ISO-8601 format.\n"
                },
                {
                  "disabled": false,
                  "key": "transferred_before",
                  "value": "<string>",
                  "description": "The later transfer date, inclusive. Accepts Unix epoch seconds or ISO-8601 format.\n"
