        {
          "id": "3b58345b-c122-46bb-8389-558547100eb2",
          "name": "Get ENS Records",
          "request": {
            "name": "Get ENS Records",
            "description": {
              "content": "Retrieve any ENS record ever created. Filter by account, owner, ENS name, node, registration date, or expiration date.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ens",
                "records"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ens_name",
                  "value": "<string>",
                  "description": "Look up a specific ENS name (e.g., vitalik.eth)."
                },
                {
                  "disabled": false,
                  "key": "owner_address",
                  "value": "<string>",
                  "description": "Filter ENS records by owner address."
                },
                {
                  "disabled": false,
                  "key": "account_address",
                  "value": "<string>",
                  "description": "Filter ENS records by resolved account address."
                },
                {
                  "disabled": false,
                  "key": "token_id",
                  "value": "<string>",
                  "description": "Filter by ENS token ID."
                },
                {
                  "disabled": false,
                  "key": "registered_after",
                  "value": "<string>",
                  "description": "Return ENS records registered after this date."
                },
                {
                  "disabled": false,
                  "key": "registered_before",
                  "value": "<string>",
                  "description": "Return ENS records registered before this date."
                },
                {
                  "disabled": false,
                  "key": "expires_after",
                  "value": "<string>",
                  "description": "Return ENS records expiring after this date."
                },
                {
                  "disabled": false,
                  "key": "expires_before",
                  "value": "<string>",
                  "description": "Return ENS records expiring before this date."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "desc",
                  "description": "Sort direction for results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
