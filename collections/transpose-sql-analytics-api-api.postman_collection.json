          "request": {
            "name": "Execute SQL Query",
            "description": {
              "content": "Execute a custom SQL query against Transpose's entire indexed blockchain dataset. Tables are namespaced by chain (e.g., ethereum.nft_sales, polygon.tokens). Supports pagination, parameterized queries, and cross-chain multichain queries. Credits consumed are returned in the X-Credits-Charged response header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
